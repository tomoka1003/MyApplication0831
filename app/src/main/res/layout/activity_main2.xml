<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"

    tools:context=".MainActivity2">


    <!-- 明示的Intent：電卓画面(MainActivity3)へ遷移 -->
    <Button
        android:id="@+id/button_a"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="明示的Intent"

        app:layout_constraintEnd_toStartOf="@+id/button_b"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <!-- 暗黙的Intent：ブラウザでYahoo!を開く -->
    <Button
        android:id="@+id/button_b"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="暗黙的Intent"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/button_a"
        app:layout_constraintTop_toTopOf="@+id/button_a" />


    <!-- 文字を入力してMainActivity3に渡す -->
    <EditText
        android:id="@+id/intent_edit_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:layout_marginStart="16dp"
        android:layout_marginTop="32dp"

        android:hint="何か書いてね"

        app:layout_constraintEnd_toStartOf="@+id/intent_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/button_a" />


    <!-- 文字を送信するボタン -->
    <Button
        android:id="@+id/intent_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_marginEnd="16dp"

        android:text="送信"

        app:layout_constraintBottom_toBottomOf="@+id/intent_edit_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/intent_edit_text" />


    <!-- 演習3：画面2から返ってきた結果を表示 -->
    <TextView
        android:id="@+id/result_text_view"

        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:layout_marginStart="16dp"
        android:layout_marginTop="32dp"

        android:text="Result:"
        android:textSize="24sp"

        app:layout_constraintEnd_toStartOf="@+id/result_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/intent_edit_text" />


    <!-- 演習3：結果を受け取るために画面2を起動 -->
    <Button
        android:id="@+id/result_button"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"

        android:text="起動"

        app:layout_constraintBottom_toBottomOf="@+id/result_text_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/result_text_view"
        app:layout_constraintTop_toTopOf="@+id/result_text_view" />

</androidx.constraintlayout.widget.ConstraintLayout>
