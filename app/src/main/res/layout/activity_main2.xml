<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity2">

    <Button
        android:id="@+id/button_a"
        android:text="明示的Intent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@+id/button_b"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/button_b" />
    <Button
        android:id="@+id/button_b"
        android:text="暗黙的Intent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/button_a"
        app:layout_constraintStart_toEndOf="@+id/button_a" />

    <TextView
        android:id="@+id/textView_visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/button_a"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_margin="16dp"
        android:text="これは表示されている"/>

    <TextView
        android:id="@+id/textView_invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/textView_visible"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_margin="16dp"
        android:text="これは最初は表示されている"/>

    <TextView
        android:id="@+id/textView_gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:layout_constraintTop_toBottomOf="@id/textView_invisible"
        app:layout_constraintStart_toStartOf="parent"
        android:text="これも最初は表示されている"/>

    <EditText
        android:id="@+id/intent_editText"
        android:layout_width="8dp"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:hint="何か書いてね"
        app:layoutconstraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id"/>


</androidx.constraintlayout.widget.ConstraintLayout>